# Public canonical origin. Use http://localhost:3000 only in a local .env.local.
NEXT_PUBLIC_SITE_URL=https://roomfacelift.com

# Video gateway: mock | fal-h3-max | minimax
VIDEO_PROVIDER=mock

# fal H3 Max (server-only)
FAL_KEY=
FAL_H3_MODEL=minimax/h3-max/image-to-video
FAL_H3_PROMPT_EXPANSION=balanced
GENERATION_VIDEO_TIMEOUT_MINUTES=30

# Legacy direct MiniMax provider
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-Hailuo-2.3

# After-frame gateway: mock | remote | fal-kontext
AFTER_IMAGE_PROVIDER=mock
AFTER_IMAGE_MODEL=fal-ai/flux-pro/kontext/max
AFTER_IMAGE_API_URL=
AFTER_IMAGE_API_KEY=

# Server-side baked watermarking (required for free real generations)
WATERMARK_SERVICE_URL=
WATERMARK_SERVICE_TOKEN=
ANON_COOKIE_SECRET=replace-with-a-long-random-secret

# Supabase (all three are required for real generation; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode
# Keep disabled until the selected production checkout flow is launch-tested.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDIT_PACK=

# Analytics and ads
# Optional. Scripts load only after the visitor accepts analytics consent.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
